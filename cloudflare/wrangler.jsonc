{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nbt-schedule",
  "main": "src/index.ts",
  "compatibility_date": "2026-04-09",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/public/*"]
  },
  "vars": {
    "CORS_ALLOW_ORIGIN": "*",
    "NBT_SCHEMA": "nbt",
    "SEASON_ASSET_PATH": "/data/season.json",
    "SITE_ORIGIN": "https://schedule.naenaewhipwhip.com"
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "REPLACE_WITH_HYPERDRIVE_ID"
    }
  ],
  "env": {
    "dev": {
      "name": "nbt-schedule-dev",
      "vars": {
        "CORS_ALLOW_ORIGIN": "*",
        "NBT_SCHEMA": "nbt",
        "SEASON_ASSET_PATH": "/data/season.json",
        "SITE_ORIGIN": "https://nbt-dev.zachbrickson.dev"
      },
      "hyperdrive": [
        {
          "binding": "HYPERDRIVE",
          "id": "REPLACE_WITH_HYPERDRIVE_ID"
        }
      ]
    }
  }
}
